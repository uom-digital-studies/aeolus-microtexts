Package: aeolusmicrotexts
Title: Sentiment Analysis of the Aeolus Microtexts
Version: 0.1.4
Authors@R: c(
    person("Jasper", "Harrington", , "jasper.harrington@student.unimelb.edu.au", role = "aut",
           comment = c(ORCID = "0009-0009-7363-5705")),
