	pages = {179--190},
	file = {Full Text PDF:/Users/falk/Zotero/storage/5CJJA73P/Barke and Murali - 2026 - Agents as Software A Programming Languages Agenda for Agent Reliability.pdf:application/pdf},
}

@misc{rabanser_towards_2026,
	title = {Towards a {Science} of {AI} {Agent} {Reliability}},
	url = {http://arxiv.org/abs/2602.16666},
	doi = {10.48550/arXiv.2602.16666},
	abstract = {AI agents are increasingly deployed to execute important tasks. While rising accuracy scores on standard benchmarks suggest rapid progress, many agents still continue to fail in practice. This discrepancy highlights a major limitation of current evaluations: focusing on a single metric is not enough to understand agent behavior. Notably, it ignores whether agents behave consistently across runs, withstand perturbations, fail predictably, or have bounded error severity. Grounded in safetycritical engineering, we provide a holistic performance profile consisting of twelve metrics that decompose agent reliability along four key dimensions:consistency,robustness,predictability, and safety. Evaluating 15 models across two complementary benchmarks, we find that recent capability gains have only yielded small improvements in reliability. By exposing these persistent limitations, our metrics complement traditional evaluations while offering tools for reasoning about how agents perform, degrade, and fail.},
	language = {en},
	urldate = {2026-10-19},
	publisher = {arXiv},
	author = {Rabanser, Stephan and Kapoor, Sayash and Kirgis, Peter and Liu, Kangheng and Utpala, Saiteja and Narayanan, Arvind},
